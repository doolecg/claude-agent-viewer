{
  "name": "claude-agent-viewer",
  "version": "1.0.0",
  "description": "Hyprland-style tiling viewer for Claude Code terminals and their subagents",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --check main.js && node --check updater.js && node --check renderer/renderer.js",
    "dist": "electron-builder --win msi --x64"
  },
  "author": {
    "name": "doolecg",
    "email": "doolecg@gmail.com"
  },
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "productName": "Claude Agent Viewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/doolecg/claude-agent-viewer.git"
  },
  "homepage": "https://github.com/doolecg/claude-agent-viewer",
  "build": {
    "appId": "com.doolecg.claude-agent-viewer",
    "productName": "Claude Agent Viewer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "msi": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Agent Viewer",
      "artifactName": "Claude-Agent-Viewer-${version}.msi"
    },
    "publish": null
  }
}
